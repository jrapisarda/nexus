# Database
# Host port exposed by docker-compose for the bundled Postgres container.
# Change to 5433 (or another free port) if you already run Postgres on 5432.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://claudeai:Magic123@localhost:5432/nexus  # Keep this port in sync with POSTGRES_PORT when using Docker

# Moonshot AI (Kimi K2.5)
MOONSHOT_API_KEY=your-api-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.5

# Budget
BUDGET_CEILING_USD=38.25
COST_INPUT_PER_MILLION=0.60
COST_OUTPUT_PER_MILLION=2.50

# Concurrency
MAX_CONCURRENT_CALLS=3
STALE_INSTANCE_TIMEOUT_SECS=900

# Economy
RENT_DECAY_RATE=0.05
RENT_DECAY_INTERVAL_MINS=60
SURVIVAL_THRESHOLD=10.00
MIN_PERSONAS_PER_ROLE_CLASS=2

# Evolution
MAX_ACTIVE_PERSONAS=20
MUTATION_MAX_EDIT_DISTANCE_PCT=0.30
DIVERSITY_THRESHOLD=0.35

# Knowledge Graph
CONFIDENCE_DECAY_PER_HOP=0.7
DEDUP_SIMILARITY_THRESHOLD=0.92
MAX_DAG_DEPTH=6
MAX_DAG_FANOUT=8

# Review
CIRCUIT_BREAKER_FAIL_MAX=2
CIRCUIT_BREAKER_RESET_TIMEOUT_SECS=300
REVIEW_VARIANCE_THRESHOLD=1.5

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
REPORTS_DIR=reports

# Scout APIs
PUBMED_API_KEY=
USPTO_API_KEY=

# Dream Cycle
DREAM_CYCLE_INACTIVITY_SECS=300
